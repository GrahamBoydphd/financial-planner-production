-- TEMPLATE 2: "The Ergodic Ecosystem" (Cooperative Resilience)
-- =================================================================
WITH new_fund AS (
    INSERT INTO funds (id, user_id, tenant_id, fund_name, currency_code, default_soft_limit_active, default_soft_limit_threshold, default_soft_limit_fraction, description, created_at)
    VALUES (
        gen_random_uuid(), 
        'd3ff7524-b593-43e8-8c53-ce2368bfe478', 
        'fd5a6c54-481b-4a03-a4a8-1df8ebb46f95', 
        'Template: The Ergodic Ecosystem', 
        'EUR', 
        true, 
        50000000, -- $50M Cap
        0.50,     -- 50% Friction (Moderate)
        'This fund demonstrates the power of cooperative risk-sharing. By setting the Pooling Fraction to 20%, companies automatically cross-insure each other against bad luck. You will observe a significantly higher survival rate compared to the Lottery model, resulting in a higher geometric average return for the fund.',
        NOW()
    ) RETURNING id
),
new_company AS (
    INSERT INTO companies (id, fund_id, tenant_id, company_name, currency_code, industry, description, created_at)
    SELECT gen_random_uuid(), id, 'fd5a6c54-481b-4a03-a4a8-1df8ebb46f95', 'Resilient Co', 'EUR', 'SaaS', 'A collaborative company participating in the pool.', NOW() FROM new_fund RETURNING id
),
new_plan AS (
    INSERT INTO financial_plans (id, company_id, tenant_id, plan_name, start_month, currency_code, initial_cash, pooling_fraction, insolvency_threshold, soft_limit_active, soft_limit_threshold, soft_limit_fraction, description, created_at)
    SELECT gen_random_uuid(), id, 'fd5a6c54-481b-4a03-a4a8-1df8ebb46f95', 'Pooled Plan', '2026-01-01', 'EUR', 1000000, 0.20, 0, true, 50000000, 0.50, 'Standard plan contributing 20% of gains to the ecosystem.', NOW() FROM new_company RETURNING id
)
INSERT INTO revenue_items (id, plan_id, revenue_name, source, start_month, initial_amount, growth_rate_percent, frequency, volatility_type, vol_mu, vol_fatness_level, created_at)
-- FIXED: Changed the hardcoded User UUID to 'id' (from new_plan)
SELECT gen_random_uuid(), id, 'Subscription Revenue', 'Recurring', 1, 50000, 2.0, 'Monthly', 'nrig', 0.0, 'Medium', NOW() FROM new_plan;

