-- SEED DATA: Three Standard Template Funds
-- Replace 'YOUR_TENANT_ID' with your specific UUID

-- =================================================================
-- TEMPLATE 1: "The Venture Lottery" (High Risk, No Pooling)
-- =================================================================
WITH new_fund AS (
    INSERT INTO funds (id, user_id, tenant_id, fund_name, currency_code, default_soft_limit_active, default_soft_limit_threshold, default_soft_limit_fraction, description, created_at)
    VALUES (
        gen_random_uuid(), 
        'd3ff7524-b593-43e8-8c53-ce2368bfe478', -- Placeholder User
        'fd5a6c54-481b-4a03-a4a8-1df8ebb46f95',  -- REPLACE THIS
        'Template: The Venture Lottery', 
        'EUR', 
        true, 
        100000000, -- $100M Cap
        0.90,      -- 90% Friction (Aggressive)
        'This represents the traditional VC model. It relies on "Power Law" dynamics: most companies will fail (insolvency), but you hope one "Galactic Empire" outlier covers the losses. Pooling is set to 0%, meaning no risk sharing. Volatility is set to "High Fat Tails" to simulate the wild unpredictability of startups.',
        NOW()
    ) RETURNING id
),
new_company AS (
    INSERT INTO companies (id, fund_id, tenant_id, company_name, currency_code, industry, description, created_at)
    SELECT gen_random_uuid(), id, 'fd5a6c54-481b-4a03-a4a8-1df8ebb46f95', 'Moonshot Inc', 'EUR', 'Technology', 'A high-risk, high-reward startup. Burning cash to grow.', NOW() FROM new_fund RETURNING id
),
new_plan AS (
    INSERT INTO financial_plans (id, company_id, tenant_id, plan_name, start_month, currency_code, initial_cash, pooling_fraction, insolvency_threshold, soft_limit_active, soft_limit_threshold, soft_limit_fraction, description, created_at)
    SELECT gen_random_uuid(), id, 'fd5a6c54-481b-4a03-a4a8-1df8ebb46f95', 'Base Case', '2026-01-01', 'EUR', 500000, 0.0, 0, true, 100000000, 0.90, 'Aggressive growth plan with zero pooling protection.', NOW() FROM new_company RETURNING id
)
INSERT INTO revenue_items (id, plan_id, revenue_name, source, start_month, initial_amount, growth_rate_percent, frequency, volatility_type, vol_mu, vol_fatness_level, created_at)
SELECT gen_random_uuid(), id, 'Viral Product Sales', 'Product', 12, 10000, 15.0, 'Monthly', 'nrig', 0.0, 'High', NOW() FROM new_plan;


