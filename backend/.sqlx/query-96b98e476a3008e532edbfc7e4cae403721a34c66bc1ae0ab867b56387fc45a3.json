  "query": "\n        SELECT \n            id, plan_id, expense_name, category, \n            start_month, end_month, \n            initial_amount, frequency, trigger_strategy,\n            created_at\n        FROM expense_items \n        WHERE plan_id = $1 \n        AND plan_id IN (SELECT id FROM financial_plans WHERE tenant_id = $2)\n        ORDER BY start_month ASC\n        ",
