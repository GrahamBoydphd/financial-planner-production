  "query": "UPDATE financial_plans \n         SET name = COALESCE($1, name), \n             start_month = COALESCE($2, start_month), \n             pooling_fraction = COALESCE($3, pooling_fraction),\n             initial_cash = COALESCE($4, initial_cash),\n             updated_at = NOW() \n         WHERE id = $5 AND tenant_id = $6\n         RETURNING id, company_id, tenant_id, name, start_month, currency_code, initial_cash, pooling_fraction, created_at, updated_at",
